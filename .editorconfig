root = true

# >>> bedrock
# bedrock_version is the bedrock release just setup installs, or "source" to run
# the CLI from the checkout; bedrock_languages and bedrock_<language>_<option>
# are what bedrock adopt and update keep. Editors ignore keys they don't know.
[*]
bedrock_version = 0.7.5
bedrock_languages = cpp, swift
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 2

[*.{yml,yaml,md,mdx}]
indent_style = space

[{justfile,*.just}]
indent_style = space
indent_size = 4

# Markdown marks a hard line break with two trailing spaces.
[*.{md,mdx}]
trim_trailing_whitespace = false

[*.{bat,cmd,ps1}]
end_of_line = crlf
# <<< bedrock

# >>> swift-bedrock
[*.swift]
indent_style = space
indent_size = 2
max_line_length = 100
# <<< swift-bedrock

# >>> swift-bedrock-cxx
# clang-tidy bounds function size but not file length, so bedrock guard counts
# each file's code lines with lizard. A file only test code compiles takes the
# test file bound instead: one in a SwiftPM package's Tests/, or one only the
# targets a CMake, Meson, or xmake project runs as tests build. A section after this block
# overrides a bound, and unset turns one off.
[*.{c,cc,cpp,cxx,h,hh,hpp,hxx,m,mm}]
indent_style = space
indent_size = 4
max_line_length = 100
bedrock_file_code_lines_warning = 603
bedrock_test_file_code_lines_warning = 603
# <<< swift-bedrock-cxx
