#ifndef SwifterKitRuntimeAudioBox_h
#define SwifterKitRuntimeAudioBox_h

#include "SwifterKitRuntimeConfiguration.h"
#if SWIFTERKIT_ENABLE_AUDIO
    #include <AudioDriverKit/IOUserAudioBox.iig>

class SwifterKitRuntimeService;

class SwifterKitRuntimeAudioBox : public IOUserAudioBox {
public:
    virtual bool init(
        IOUserAudioDriver* driver,
        SwifterKitRuntimeService* service,
        uint32_t index,
        bool isAcquirable,
        OSString* uid) LOCALONLY;
    virtual void free() override LOCALONLY;

    kern_return_t Configure(const SwifterKitAudioBoxConfiguration* configuration) LOCALONLY;
    virtual kern_return_t HandleChangeAcquireBox(bool acquire) LOCALONLY override;
};
#endif
#endif
