#ifndef SwifterKitRuntimeVideoDevice_h
#define SwifterKitRuntimeVideoDevice_h

#include "SwifterKitRuntimeConfiguration.h"
#include "SwifterKitRuntimeProtocol.h"
#include "SwifterKitRuntimeVideoProtocol.h"
#if SWIFTERKIT_ENABLE_VIDEO
    #include <VideoDriverKit/IOUserVideoBuffer.iig>
    #include <VideoDriverKit/IOUserVideoDevice.iig>

class SwifterKitRuntimeService;

class SwifterKitRuntimeVideoDevice : public IOUserVideoDevice {
public:
    virtual bool init(
        IOUserVideoDriver* driver,
        SwifterKitRuntimeService* service,
        OSString* deviceUID,
        OSString* modelUID,
        OSString* manufacturerUID) LOCALONLY;
    virtual void free() override LOCALONLY;

    kern_return_t Configure() LOCALONLY;
    kern_return_t ReadBuffer(const SwifterKitVideoTransferHeader* transfer, OSData** response)
        LOCALONLY;
    kern_return_t WriteBuffer(const SwifterKitVideoTransferHeader* transfer, const uint8_t* bytes)
        LOCALONLY;
    kern_return_t EnqueueOutput(uint32_t streamIndex, const SwifterKitVideoQueueEntry* entry)
        LOCALONLY;
    kern_return_t DequeueInput(uint32_t streamIndex, OSData** response) LOCALONLY;
    kern_return_t NotifyOutput(uint32_t streamIndex) LOCALONLY;
    kern_return_t UpdateTimestamp(const SwifterKitVideoTimestamp* timestamp) LOCALONLY;
    kern_return_t RequestSampleRate(double sampleRate) LOCALONLY;
    kern_return_t ConfigureControls() LOCALONLY;
    kern_return_t CopyControl(const SwifterKitVideoControlGet* request, OSData** response)
        LOCALONLY;
    kern_return_t SetControl(
        const SwifterKitVideoControlValueHeader* request,
        const uint32_t* values) LOCALONLY;
    kern_return_t CopyCustomProperty(
        const SwifterKitVideoCustomPropertyHeader* request,
        const uint8_t* bytes,
        OSData** response) LOCALONLY;
    kern_return_t SetCustomProperty(
        const SwifterKitVideoCustomPropertyHeader* request,
        const uint8_t* bytes) LOCALONLY;
    kern_return_t NotifyBufferQueue(uint32_t kind, uint32_t streamIndex, uint64_t changeAction)
        LOCALONLY;
    kern_return_t SetCustomPropertyOwner(uint32_t identifier, uint32_t owner) LOCALONLY;
    void RemoveControlsAndProperties() LOCALONLY;
    kern_return_t MemberCommand(
        uint32_t opcode,
        const uint8_t* payload,
        uint32_t payloadLength,
        OSData** response) LOCALONLY;
    kern_return_t CopyDeviceState(OSData** response) LOCALONLY;
    kern_return_t SetDeviceProperty(const SwifterKitVideoMemberValue* request) LOCALONLY;
    kern_return_t CopyStreamState(const SwifterKitVideoMemberRequest* request, OSData** response)
        LOCALONLY;
    kern_return_t SetStreamProperty(const SwifterKitVideoMemberProperty* request) LOCALONLY;
    kern_return_t CopyBufferInfo(const SwifterKitVideoMemberRequest* request, OSData** response)
        LOCALONLY;
    kern_return_t SetBufferProperty(const SwifterKitVideoBufferProperty* request) LOCALONLY;
    kern_return_t CopyControlInfo(const SwifterKitVideoMemberRequest* request, OSData** response)
        LOCALONLY;
    kern_return_t SetControlProperty(const SwifterKitVideoMemberProperty* request) LOCALONLY;
    kern_return_t RemoveSelectorItems(
        const SwifterKitVideoSelectorRemoval* request,
        const uint8_t* values) LOCALONLY;
    kern_return_t CopyCustomPropertyInfo(
        const SwifterKitVideoMemberRequest* request,
        OSData** response) LOCALONLY;
    kern_return_t SetMemberAttachment(const SwifterKitVideoMemberAttachment* request) LOCALONLY;
    kern_return_t EnqueueOutputBuffer(uint32_t streamIndex, const SwifterKitVideoQueueEntry* entry)
        LOCALONLY;
    kern_return_t RequestMemberChange(
        uint32_t kind,
        uint32_t stream,
        uint32_t buffer,
        uint64_t value) LOCALONLY;
    kern_return_t ApplyMemberChange() LOCALONLY;
    kern_return_t NativeEntry(
        uint32_t streamIndex,
        const SwifterKitVideoQueueEntry* entry,
        IOStreamBufferQueueEntry* native) LOCALONLY;
    kern_return_t ApplyBufferCapacity(uint32_t stream, uint64_t value) LOCALONLY;
    kern_return_t ApplyBufferList(uint32_t stream, uint32_t buffer, bool attach) LOCALONLY;

protected:
    virtual kern_return_t StartIO(IOUserVideoStartStopFlags flags) LOCALONLY override;
    virtual kern_return_t StopIO(IOUserVideoStartStopFlags flags) LOCALONLY override;
    virtual kern_return_t PerformDeviceConfigurationChange(
        uint64_t changeAction,
        OSObject* changeInfo) LOCALONLY override;
    virtual kern_return_t AbortDeviceConfigurationChange(
        uint64_t changeAction,
        OSObject* changeInfo) LOCALONLY override;
    virtual kern_return_t HandleChangeSampleRate(double sampleRate) LOCALONLY override;
    virtual void StreamFormatChanged(IOUserVideoObjectID streamID) LOCALONLY override;
};
#endif
#endif
